<Window x:Class="NetLoom.Wpf.ManualTopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="{DynamicResource NetLoom.Window.Height}"
        Width="{DynamicResource NetLoom.Window.Width}"
        MinHeight="{DynamicResource NetLoom.Window.MinHeight}"
        MinWidth="{DynamicResource NetLoom.Window.MinWidth}"
        FontFamily="{DynamicResource NetLoom.FontFamily.Ui}"
        FontSize="{DynamicResource NetLoom.FontSize.Body}"
        Background="{DynamicResource NetLoom.Brush.Window}"
        Foreground="{DynamicResource NetLoom.Brush.TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Style="{StaticResource NetLoom.Style.Panel}"
                Padding="{DynamicResource NetLoom.Thickness.PanelPadding}"
                BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}">
            <StackPanel>
                <TextBlock x:Name="ManualTopologyTitleText"
                           Style="{StaticResource NetLoom.Style.WindowTitle}" />
                <TextBlock x:Name="ManualTopologyIntroText"
                           Style="{StaticResource NetLoom.Style.MutedText}"
                           Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ManualTopologyInteractionHintText"
                           Style="{StaticResource NetLoom.Style.MutedText}"
                           Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ManualTopologyStatusText"
                           Style="{StaticResource NetLoom.Style.StatusEmphasis}"
                           Margin="{DynamicResource NetLoom.Thickness.StatusTop}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource NetLoom.Style.Panel}"
                Padding="{DynamicResource NetLoom.Thickness.PanelPadding}"
                BorderThickness="{DynamicResource NetLoom.Thickness.BorderTop}">
            <Button x:Name="ManualTopologyCloseButton"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick" />
        </Border>

        <TabControl x:Name="ManualTopologyTabs"
                    Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
            <TabItem x:Name="ManualDevicesTab">
                <Grid Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ManualDevicesListLabelText"
                                   Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                        <ListBox x:Name="ManualDevicesList"
                                 Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                 DisplayMemberPath="Summary"
                                 SelectionChanged="OnDeviceSelectionChanged"
                                 MouseDoubleClick="OnDeviceListDoubleClick"
                                 PreviewMouseRightButtonDown="OnDeviceListPreviewMouseRightButtonDown"
                                 ContextMenuOpening="OnDeviceContextMenuOpening"
                                 KeyDown="OnDeviceListKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ManualDeviceContextEdit"
                                              Click="OnDeviceContextEditClick" />
                                    <Separator />
                                    <MenuItem x:Name="ManualDeviceContextDelete"
                                              Click="OnDeviceContextDeleteClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource NetLoom.Style.Panel}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderLeft}"
                            Padding="{DynamicResource NetLoom.Thickness.PanelPadding}">
                        <StackPanel>
                            <TextBlock x:Name="ManualDeviceNameLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                            <TextBox x:Name="ManualDeviceNameTextBox"
                                     Margin="{DynamicResource NetLoom.Thickness.GapXsTop}" />

                            <TextBlock x:Name="ManualDeviceCategoryLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <ComboBox x:Name="ManualDeviceCategoryComboBox"
                                      DisplayMemberPath="Text" />

                            <TextBlock x:Name="ManualDeviceNotesLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <TextBox x:Name="ManualDeviceNotesTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource NetLoom.Thickness.StatusTop}">
                                <Button x:Name="ManualDeviceNewButton"
                                        Click="OnNewDeviceClick" />
                                <Button x:Name="ManualDeviceCreateButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnCreateDeviceClick" />
                                <Button x:Name="ManualDeviceSaveButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnSaveDeviceClick" />
                                <Button x:Name="ManualDeviceDeleteButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnDeleteDeviceClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ManualPortsTab">
                <Grid Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ManualPortDeviceLabelText"
                                   Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                        <ComboBox x:Name="ManualPortDeviceComboBox"
                                  Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                  DisplayMemberPath="Summary"
                                  SelectionChanged="OnPortDeviceSelectionChanged" />

                        <TextBlock x:Name="ManualPortsListLabelText"
                                   Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                   Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                        <ListBox x:Name="ManualPortsList"
                                 Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                 DisplayMemberPath="Summary"
                                 SelectionChanged="OnPortSelectionChanged"
                                 MouseDoubleClick="OnPortListDoubleClick"
                                 PreviewMouseRightButtonDown="OnPortListPreviewMouseRightButtonDown"
                                 ContextMenuOpening="OnPortContextMenuOpening"
                                 KeyDown="OnPortListKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ManualPortContextEdit"
                                              Click="OnPortContextEditClick" />
                                    <Separator />
                                    <MenuItem x:Name="ManualPortContextDelete"
                                              Click="OnPortContextDeleteClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource NetLoom.Style.Panel}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderLeft}"
                            Padding="{DynamicResource NetLoom.Thickness.PanelPadding}">
                        <StackPanel>
                            <TextBlock x:Name="ManualPortNameLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                            <TextBox x:Name="ManualPortNameTextBox"
                                     Margin="{DynamicResource NetLoom.Thickness.GapXsTop}" />

                            <TextBlock x:Name="ManualPortMediaLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <ComboBox x:Name="ManualPortMediaComboBox"
                                      IsEditable="True"
                                      DisplayMemberPath="Text" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource NetLoom.Thickness.StatusTop}">
                                <Button x:Name="ManualPortNewButton"
                                        Click="OnNewPortClick" />
                                <Button x:Name="ManualPortCreateButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnCreatePortClick" />
                                <Button x:Name="ManualPortSaveButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnSavePortClick" />
                                <Button x:Name="ManualPortDeleteButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnDeletePortClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ManualLinksTab">
                <Grid Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ManualLinksListLabelText"
                                   Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                        <ListBox x:Name="ManualLinksList"
                                 Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                 DisplayMemberPath="Summary"
                                 SelectionChanged="OnLinkSelectionChanged"
                                 MouseDoubleClick="OnLinkListDoubleClick"
                                 PreviewMouseRightButtonDown="OnLinkListPreviewMouseRightButtonDown"
                                 ContextMenuOpening="OnLinkContextMenuOpening"
                                 KeyDown="OnLinkListKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ManualLinkContextEdit"
                                              Click="OnLinkContextEditClick" />
                                    <Separator />
                                    <MenuItem x:Name="ManualLinkContextDelete"
                                              Click="OnLinkContextDeleteClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource NetLoom.Style.Panel}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderLeft}"
                            Padding="{DynamicResource NetLoom.Thickness.PanelPadding}">
                        <StackPanel>
                            <TextBlock x:Name="ManualLinkEndpointATitleText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                            <ComboBox x:Name="ManualLinkDeviceAComboBox"
                                      Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                      DisplayMemberPath="Summary"
                                      SelectionChanged="OnLinkDeviceASelectionChanged" />
                            <ComboBox x:Name="ManualLinkPortAComboBox"
                                      Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                      DisplayMemberPath="Summary" />

                            <TextBlock x:Name="ManualLinkEndpointBTitleText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <ComboBox x:Name="ManualLinkDeviceBComboBox"
                                      Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                      DisplayMemberPath="Summary"
                                      SelectionChanged="OnLinkDeviceBSelectionChanged" />
                            <ComboBox x:Name="ManualLinkPortBComboBox"
                                      Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                      DisplayMemberPath="Summary" />

                            <TextBlock x:Name="ManualLinkMediaLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <ComboBox x:Name="ManualLinkMediaComboBox"
                                      IsEditable="True"
                                      DisplayMemberPath="Text" />

                            <TextBlock x:Name="ManualLinkNotesLabelText"
                                       Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabel}" />
                            <TextBox x:Name="ManualLinkNotesTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource NetLoom.Thickness.StatusTop}">
                                <Button x:Name="ManualLinkNewButton"
                                        Click="OnNewLinkClick" />
                                <Button x:Name="ManualLinkCreateButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnCreateLinkClick" />
                                <Button x:Name="ManualLinkSaveButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnSaveLinkClick" />
                                <Button x:Name="ManualLinkDeleteButton"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                        Click="OnDeleteLinkClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
