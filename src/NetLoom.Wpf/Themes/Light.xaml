<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="NetLoom.Brush.Window" Color="#F3F6F9" />
    <SolidColorBrush x:Key="NetLoom.Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NetLoom.Brush.SurfaceMuted" Color="#F8FAFC" />
    <SolidColorBrush x:Key="NetLoom.Brush.SurfaceHover" Color="#EEF3F8" />
    <SolidColorBrush x:Key="NetLoom.Brush.Canvas" Color="#EDF2F6" />
    <Color x:Key="NetLoom.Color.OverlayShadow">#17212B</Color>

    <SolidColorBrush x:Key="NetLoom.Brush.ShellRail" Color="#1F2A38" />
    <SolidColorBrush x:Key="NetLoom.Brush.ShellRailHover" Color="#29384A" />
    <SolidColorBrush x:Key="NetLoom.Brush.ShellRailSelected" Color="#31455A" />
    <SolidColorBrush x:Key="NetLoom.Brush.ShellRailText" Color="#E5EBF1" />
    <SolidColorBrush x:Key="NetLoom.Brush.ShellRailTextMuted" Color="#AAB6C3" />
    <SolidColorBrush x:Key="NetLoom.Brush.ShellRailBorder" Color="#334253" />

    <SolidColorBrush x:Key="NetLoom.Brush.Border" Color="#CBD5DF" />
    <SolidColorBrush x:Key="NetLoom.Brush.BorderStrong" Color="#8FA1B2" />

    <SolidColorBrush x:Key="NetLoom.Brush.TextPrimary" Color="#17212B" />
    <SolidColorBrush x:Key="NetLoom.Brush.TextSecondary" Color="#526170" />
    <SolidColorBrush x:Key="NetLoom.Brush.TextDisabled" Color="#8A98A6" />

    <SolidColorBrush x:Key="NetLoom.Brush.Accent" Color="#2F6FED" />
    <SolidColorBrush x:Key="NetLoom.Brush.AccentHover" Color="#245FD0" />
    <SolidColorBrush x:Key="NetLoom.Brush.AccentPressed" Color="#1D4FAF" />
    <SolidColorBrush x:Key="NetLoom.Brush.AccentSoft" Color="#EAF1FF" />
    <!-- §6: текст акцентом на AccentSoft (чипы) — 5.6:1; Accent на AccentSoft даёт только 4.0:1. -->
    <SolidColorBrush x:Key="NetLoom.Brush.AccentText" Color="#2459C4" />
    <SolidColorBrush x:Key="NetLoom.Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="NetLoom.Brush.Success" Color="#1F7A5A" />
    <SolidColorBrush x:Key="NetLoom.Brush.SuccessSoft" Color="#E7F5EF" />
    <!-- §6: ≥4.5:1 к белому и к WarningSoft (было #B76C08 — 4.07 и 3.68). -->
    <SolidColorBrush x:Key="NetLoom.Brush.Warning" Color="#975905" />
    <SolidColorBrush x:Key="NetLoom.Brush.WarningSoft" Color="#FFF2DC" />
    <!-- §6: ≥4.5:1 к белому и к CriticalSoft (было #C63D3D — 4.35 на CriticalSoft). -->
    <SolidColorBrush x:Key="NetLoom.Brush.Critical" Color="#B83434" />
    <SolidColorBrush x:Key="NetLoom.Brush.CriticalSoft" Color="#FCE9E9" />

    <SolidColorBrush x:Key="NetLoom.Brush.Link" Color="#53697E" />
    <SolidColorBrush x:Key="NetLoom.Brush.Selection" Color="#2F6FED" />
    <SolidColorBrush x:Key="NetLoom.Brush.FocusRing" Color="#2F6FED" />
    <!-- Граница размещения: не ниже 3:1 к холсту, без изменения рамок остальных поверхностей. -->
    <SolidColorBrush x:Key="NetLoom.Brush.MapLocationBorder" Color="#7A8B9C" />
</ResourceDictionary>
