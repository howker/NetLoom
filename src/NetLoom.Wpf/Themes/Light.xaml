    <SolidColorBrush x:Key="NetLoom.Brush.AccentSoft" Color="#EAF1FF" />
    <SolidColorBrush x:Key="NetLoom.Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="NetLoom.Brush.Success" Color="#237A52" />
    <SolidColorBrush x:Key="NetLoom.Brush.Warning" Color="#A86414" />
    <SolidColorBrush x:Key="NetLoom.Brush.Critical" Color="#B93C3C" />

    <SolidColorBrush x:Key="NetLoom.Brush.Link" Color="#53697E" />
