                                      StrokeThickness="1.6"
                                      Data="M 0,4 L 3,7 L 10,0"
                                      Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="{DynamicResource NetLoom.Thickness.MenuHeaderMargin}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource NetLoom.Brush.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Width="{DynamicResource NetLoom.Menu.ArrowWidth}"
                                      Height="{DynamicResource NetLoom.Menu.ArrowHeight}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.4"
                                      Data="M 0,0 L 5,5 L 0,10"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource NetLoom.Brush.Surface}"
                                    BorderBrush="{DynamicResource NetLoom.Brush.BorderStrong}"
                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                    CornerRadius="{DynamicResource NetLoom.Radius.Panel}"
                                    Padding="{DynamicResource NetLoom.Thickness.MenuPadding}">
                                <ScrollViewer CanContentScroll="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="MenuItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="IconPresenter"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role"
                                 Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="{DynamicResource NetLoom.Menu.SeparatorHeight}"
                            Margin="{DynamicResource NetLoom.Thickness.MenuSeparatorMargin}"
                            Background="{DynamicResource NetLoom.Brush.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ToolTipPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Panel}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.SecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.SidebarActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Sidebar.ActionMinWidth}" />
    </Style>

    <Style x:Key="NetLoom.Style.SidebarSecondaryActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Sidebar.ActionMinWidth}" />
    </Style>

    <!-- E1 (sprint46-mockup-gap): строка таблицы «Оборудование» по макету netloom-v2-2 — без собственной рамки,
         строки разделены линией; выбранная строка — заливка AccentSoft и полоса акцента слева; рамка фокуса поверх. -->
    <Style x:Key="NetLoom.Style.EquipmentRowButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="RowChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="RowSelectionStripe"
                                    Width="{DynamicResource NetLoom.Equipment.SelectionStripeWidth}"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding BorderBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="RowFocusRing"
                                    BorderBrush="Transparent"
                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderFocus}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="RowChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}"
                                     Value="True">
                            <Setter TargetName="RowSelectionStripe"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="RowFocusRing"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Заливка выбранной строки — свойство самой кнопки (её проверяет Sprint46ShellFoundationTests). -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
                <!-- BorderBrush выбранной строки рисует полосу акцента слева (RowSelectionStripe). -->
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Accent}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.NavigationButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.ShellRailText}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.ShellRail}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.ShellRail}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.None}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.ShellNavigationButtonMargin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.NavigationButtonPadding}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.ShellRailText}" />
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.ShellRailHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.ShellRailHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.NavigationText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="NetLoom.Style.NavigationIcon"
           TargetType="{x:Type Path}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Navigation.IconSize}" />
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Navigation.IconSize}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.NavigationIcon}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        <Setter Property="StrokeThickness"
                Value="1.6" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="Fill"
                Value="Transparent" />
    </Style>

    <Style x:Key="NetLoom.Style.NavigationBadge"
           TargetType="{x:Type Border}">
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Navigation.BadgeHeight}" />
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Navigation.BadgeMinWidth}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.NavigationBadge}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.NavigationBadgePaddingSingle}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Critical}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.NavigationBadge}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>


    <Style x:Key="NetLoom.Style.InspectorTabs"
           TargetType="{x:Type TabControl}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.InspectorContentPadding}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsPresenter Grid.Row="0" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.InspectorTab"
           TargetType="{x:Type TabItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="InspectorTabChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Control}">
                        <ContentPresenter x:Name="InspectorTabHeaderPresenter"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform Y="{DynamicResource NetLoom.Type.OpticalOffsetY}" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Opacity"
                                    Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.OperatorCard" TargetType="{x:Type Border}" BasedOn="{StaticResource NetLoom.Style.Panel}">
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.PanelPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NetLoom.Radius.Card}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style x:Key="NetLoom.Style.OperatorExpander" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
    </Style>

    <!-- G5 (sprint46-mockup-gap), §4 «Подпись раздела»: мелко, серым, заглавными стилем; текст в ресурсах — обычный регистр. -->
    <Style x:Key="NetLoom.Style.SidebarSectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="shell:TextCase.Upper" Value="True" />
    </Style>

    <!-- G5: заголовок столбца таблицы — подпись поля, заглавными и полужирным, как в макете netloom-v2-2. -->
    <Style x:Key="NetLoom.Style.TableHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource NetLoom.Style.FieldLabel}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="shell:TextCase.Upper" Value="True" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeStatusIcon"
           TargetType="{x:Type Path}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Status.GlyphMinWidth}" />
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Status.GlyphMinWidth}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.StatusGlyph}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Fill"
                Value="Transparent" />
        <Setter Property="StrokeThickness"
                Value="1.6" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
    </Style>

    <Style x:Key="NetLoom.Style.StatusGlyph"
           TargetType="{x:Type TextBlock}">
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Status.GlyphMinWidth}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.StatusGlyph}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="LineStackingStrategy"
                Value="BlockLineHeight" />
        <Setter Property="LineHeight"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="{DynamicResource NetLoom.Type.OpticalOffsetY}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.CardTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <!-- G6 (sprint46-mockup-gap): группа взаимоисключающих вариантов — одна рамка, сегменты без своих рамок;
         выбранный сегмент получает заливку AccentSoft и рамку Accent из SetMapModeSelection. -->
    <Style x:Key="NetLoom.Style.SegmentedGroup" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NetLoom.Radius.Control}" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.SegmentedGroupPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="NetLoom.Style.SegmentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="{DynamicResource NetLoom.Thickness.None}" />
    </Style>

    <!-- G4 (sprint46-mockup-gap): плоская кнопка без рамки для строки событий; рамка появляется при наведении и фокусе. -->
    <Style x:Key="NetLoom.Style.FlatButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.FlatButtonPadding}" />
    </Style>

    <Style x:Key="NetLoom.Style.EventBadge" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="{DynamicResource NetLoom.Event.BadgeSize}" />
        <Setter Property="Height" Value="{DynamicResource NetLoom.Event.BadgeSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NetLoom.Radius.EventBadge}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="NetLoom.Style.LinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <!-- §6: ссылка — это текст, поэтому токен акцентного текста, а не заливки: на приглушённой карточке
             (SurfaceMuted) заливочный Accent давал 4.35:1 при норме 4.5:1. -->
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.AccentText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.None}" />
        <!-- §8: площадь нажатия ссылки не меньше 24×24, текст центрируется по высоте. -->
        <Setter Property="MinHeight" Value="{DynamicResource NetLoom.Control.MinHitSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="NetLoom.Style.AlertSummary" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Caption}" />
    </Style>

</ResourceDictionary>
