    <Style x:Key="NetLoom.Style.InspectorTabs"
           TargetType="{x:Type TabControl}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.InspectorContentPadding}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsPresenter Grid.Row="0" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.InspectorTab"
           TargetType="{x:Type TabItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="InspectorTabChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Control}">
                        <ContentPresenter x:Name="InspectorTabHeaderPresenter"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform Y="{DynamicResource NetLoom.Type.OpticalOffsetY}" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Opacity"
                                    Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

