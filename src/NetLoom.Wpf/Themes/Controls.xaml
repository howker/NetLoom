<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:NetLoom.Wpf.Shell">

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ControlPaddingOptical}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="TextBlock.LineStackingStrategy"
                Value="BlockLineHeight" />
        <Setter Property="TextBlock.LineHeight"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ControlPaddingOptical}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ControlPadding}" />
        <Setter Property="TextBlock.LineStackingStrategy"
                Value="BlockLineHeight" />
        <Setter Property="TextBlock.LineHeight"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource NetLoom.Radius.Control}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Справа резервируется место под стрелку, длинный текст обрезается многоточием. -->
                                <Grid Margin="{DynamicResource NetLoom.Thickness.ComboBoxTextReserve}">
                                    <ContentPresenter x:Name="SelectionPresenter"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"
                                                      IsHitTestVisible="False"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextTrimming"
                                                        Value="CharacterEllipsis" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                        <ContentPresenter.RenderTransform>
                                            <TranslateTransform Y="{DynamicResource NetLoom.Type.OpticalOffsetY}" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                    <TextBlock x:Name="PlaceholderPresenter"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource NetLoom.Brush.TextSecondary}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="{DynamicResource NetLoom.Type.OpticalOffsetY}" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <Path HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="{DynamicResource NetLoom.Thickness.ComboBoxArrowMargin}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      IsHitTestVisible="False"
                                      Data="M 0,0 L 4,4 L 8,0" />
                            </Grid>
                        </Border>

                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupChrome"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource NetLoom.Brush.Surface}"
                                    BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                    CornerRadius="{DynamicResource NetLoom.Radius.Control}">
                                <ScrollViewer CanContentScroll="True"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex"
                                 Value="-1">
                            <Setter TargetName="PlaceholderPresenter"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                            <Setter Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Border}" />
                            <Setter TargetName="PlaceholderPresenter"
                                    Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.MapScrollBarPageButton"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.MapScrollBarThumb"
           TargetType="{x:Type Thumb}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Margin="{DynamicResource NetLoom.Thickness.MapScrollBarThumbInset}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Pill}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="NetLoom.Template.MapVerticalScrollBar"
                     TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NetLoom.Style.MapScrollBarPageButton}"
                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource NetLoom.Style.MapScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NetLoom.Style.MapScrollBarPageButton}"
                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="NetLoom.Template.MapHorizontalScrollBar"
                     TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NetLoom.Style.MapScrollBarPageButton}"
                                  Command="{x:Static ScrollBar.PageLeftCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource NetLoom.Style.MapScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NetLoom.Style.MapScrollBarPageButton}"
                                  Command="{x:Static ScrollBar.PageRightCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="NetLoom.Style.MapScrollBar"
           TargetType="{x:Type ScrollBar}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Canvas}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Map.ScrollBarThickness}" />
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Map.ScrollBarThickness}" />
        <Setter Property="Template"
                Value="{StaticResource NetLoom.Template.MapVerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height"
                        Value="{DynamicResource NetLoom.Map.ScrollBarThickness}" />
                <Setter Property="MinHeight"
                        Value="{DynamicResource NetLoom.Map.ScrollBarThickness}" />
                <Setter Property="Template"
                        Value="{StaticResource NetLoom.Template.MapHorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.MapScrollViewer"
           TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Canvas}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Column="0"
                                                Grid.Row="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                Margin="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   Orientation="Vertical"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Minimum="0"
                                   Orientation="Horizontal"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                        <Border x:Name="MapScrollBarCorner"
                                Grid.Column="1"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <!-- §8: текст флажка — часть площади нажатия, высота не меньше 24. -->
        <Setter Property="MinHeight" Value="{DynamicResource NetLoom.Control.MinHitSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- G7 (sprint46-mockup-gap): тематический флажок вместо системного белого квадрата (§6);
             рамка — BorderStrong (≥3:1), отмеченный — заливка акцентом, рамка фокуса (§8). -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckFocus"
                                VerticalAlignment="Center"
                                BorderBrush="Transparent"
                                BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                CornerRadius="{DynamicResource NetLoom.Radius.Control}"
                                Padding="{DynamicResource NetLoom.Thickness.BorderThin}">
                            <Border x:Name="CheckBoxChrome"
                                    Width="{DynamicResource NetLoom.CheckBox.Size}"
                                    Height="{DynamicResource NetLoom.CheckBox.Size}"
                                    Background="{DynamicResource NetLoom.Brush.Surface}"
                                    BorderBrush="{DynamicResource NetLoom.Brush.BorderStrong}"
                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                    CornerRadius="{DynamicResource NetLoom.Radius.Control}">
                                <Path x:Name="CheckMark"
                                      Margin="{DynamicResource NetLoom.Thickness.CheckMark}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource NetLoom.Brush.OnAccent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 0,4 L 3,7 L 9,0"
                                      Visibility="Collapsed" />
                            </Border>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="{DynamicResource NetLoom.Thickness.CheckBoxContent}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckBoxChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                            <Setter TargetName="CheckBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="CheckBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="CheckFocus"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                            <Setter TargetName="CheckBoxChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
                            <Setter TargetName="CheckBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тематический Expander: стрелка «›/⌄» как в макетах ADR-083 вместо системного белого кружка
         (§6: ни одного белого системного участка в тёмной теме), заголовок не ниже 28 (§8), рамка фокуса. -->
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderSite"
                                      DockPanel.Dock="Top"
                                      Focusable="True"
                                      MinHeight="{DynamicResource NetLoom.Expander.HeaderMinHeight}"
                                      HorizontalContentAlignment="Stretch"
                                      Foreground="{TemplateBinding Foreground}"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="HeaderChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderFocus}"
                                            CornerRadius="{DynamicResource NetLoom.Radius.Control}"
                                            Padding="{DynamicResource NetLoom.Thickness.ExpanderHeaderPadding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="HeaderArrow"
                                                  Width="{DynamicResource NetLoom.Expander.ArrowSize}"
                                                  Height="{DynamicResource NetLoom.Expander.ArrowSize}"
                                                  Margin="{DynamicResource NetLoom.Thickness.ExpanderArrowMargin}"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M 0,0 L 4,4 L 0,8"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"
                                                 Value="True">
                                            <Setter TargetName="HeaderArrow"
                                                    Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="HeaderChrome"
                                                    Property="Background"
                                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused"
                                                 Value="True">
                                            <Setter TargetName="HeaderChrome"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded"
                                 Value="True">
                            <Setter TargetName="ExpandSite"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ButtonPadding}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.OnAccent}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="TextBlock.LineStackingStrategy"
                Value="BlockLineHeight" />
        <Setter Property="TextBlock.LineHeight"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Control}"
