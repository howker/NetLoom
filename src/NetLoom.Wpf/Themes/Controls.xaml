<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ControlPadding}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ButtonPadding}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.OnAccent}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentPressed}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Border}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.Panel"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
    </Style>

    <Style x:Key="NetLoom.Style.WindowTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.WindowTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.SectionTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.SectionTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.MutedText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="NetLoom.Style.SubsectionLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.MonoText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Mono}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.StatusEmphasis"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeCard"
           TargetType="{x:Type Border}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Map.NodeWidth}" />
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Map.NodeHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.MapNodePadding}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.MapNode}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.MapNodeTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeSecondary"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeSecondary}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeMeta"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeMeta}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLink"
           TargetType="{x:Type Line}">
        <Setter Property="Stroke"
                Value="{DynamicResource NetLoom.Brush.Link}" />
        <Setter Property="StrokeThickness"
                Value="{DynamicResource NetLoom.Map.LinkStrokeThickness}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLinkLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.MapLinkLabelPadding}" />
    </Style>
</ResourceDictionary>
