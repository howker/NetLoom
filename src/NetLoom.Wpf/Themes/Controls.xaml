<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ControlPadding}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight" Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.ControlPadding}" />
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Control.MinHeight}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ButtonPadding}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.OnAccent}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentPressed}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Border}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Ui}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.Panel"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
    </Style>

    <Style x:Key="NetLoom.Style.WindowTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.WindowTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.SectionTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.SectionTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.MutedText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="NetLoom.Style.SubsectionLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.FieldLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.FieldLabelCompact}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
    </Style>

    <Style x:Key="NetLoom.Style.MonoText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="{DynamicResource NetLoom.FontFamily.Mono}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.StatusEmphasis"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeCard"
           TargetType="{x:Type Border}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Map.NodeWidth}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource NetLoom.Map.NodeHeight}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.MapNode}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeStateStripe"
           TargetType="{x:Type Border}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Map.NodeStateStripeWidth}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeStateStripe}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.MapNodeStateStripe}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.MapNodeTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="TextTrimming"
                Value="None" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeCategoryIcon"
           TargetType="{x:Type Path}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Map.NodeIconSize}" />
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Map.NodeIconSize}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeIcon}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Stroke"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="StrokeThickness"
                Value="1.6" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="Fill"
                Value="Transparent" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeLockBadge"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.InlineGap}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeSecondary"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeSecondary}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
    </Style>

    <Style x:Key="NetLoom.Style.MapNodeMeta"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.MapNodeMeta}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLink"
           TargetType="{x:Type Line}">
        <Setter Property="Stroke"
                Value="{DynamicResource NetLoom.Brush.Link}" />
        <Setter Property="StrokeThickness"
                Value="{DynamicResource NetLoom.Map.LinkStrokeThickness}" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLinkLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.MapLinkLabelPadding}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLocationContainer"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.MapLocation}" />
        <Setter Property="ClipToBounds"
                Value="True" />
        <Setter Property="Opacity"
                Value="0.68" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLocationTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.SectionTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLocationDescription"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
    </Style>

    <Style x:Key="NetLoom.Style.MapLocationLockBadge"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.InlineGap}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="FontSize"
                Value="{DynamicResource NetLoom.FontSize.Caption}" />
    </Style>


    <Style x:Key="NetLoom.Style.SecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.AccentSoft}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.NavigationButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.ShellRailTextMuted}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.ShellRail}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.ShellRail}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.None}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.ShellNavigationButtonMargin}" />
        <Setter Property="Padding"
                Value="12,10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource NetLoom.Brush.ShellRailText}" />
                <Setter Property="Background"
                        Value="{DynamicResource NetLoom.Brush.ShellRailHover}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource NetLoom.Brush.ShellRailHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NetLoom.Style.NavigationIcon"
           TargetType="{x:Type Path}">
        <Setter Property="Width"
                Value="{DynamicResource NetLoom.Navigation.IconSize}" />
        <Setter Property="Height"
                Value="{DynamicResource NetLoom.Navigation.IconSize}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.NavigationIcon}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        <Setter Property="StrokeThickness"
                Value="1.6" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="Fill"
                Value="Transparent" />
    </Style>

    <Style x:Key="NetLoom.Style.NavigationBadge"
           TargetType="{x:Type Border}">
        <Setter Property="MinWidth"
                Value="{DynamicResource NetLoom.Navigation.BadgeMinWidth}" />
        <Setter Property="Margin"
                Value="{DynamicResource NetLoom.Thickness.NavigationBadge}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.NavigationBadgePadding}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Critical}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource NetLoom.Radius.Pill}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>


    <Style x:Key="NetLoom.Style.InspectorTabs"
           TargetType="{x:Type TabControl}">
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.Surface}" />
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style x:Key="NetLoom.Style.InspectorTab"
           TargetType="{x:Type TabItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="Background"
                Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource NetLoom.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
        <Setter Property="Padding"
                Value="{DynamicResource NetLoom.Thickness.ListItemPadding}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="InspectorTabChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NetLoom.Radius.Control}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Background"
                                    Value="{DynamicResource NetLoom.Brush.SurfaceHover}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource NetLoom.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NetLoom.Brush.TextDisabled}" />
                            <Setter TargetName="InspectorTabChrome"
                                    Property="Opacity"
                                    Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NetLoom.Style.OperatorCard" TargetType="{x:Type Border}" BasedOn="{StaticResource NetLoom.Style.Panel}">
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.PanelPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NetLoom.Radius.Card}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NetLoom.Thickness.BorderThin}" />
    </Style>

    <Style x:Key="NetLoom.Style.OperatorExpander" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
    </Style>

    <Style x:Key="NetLoom.Style.SidebarSectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="NetLoom.Style.CardTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
    </Style>

    <Style x:Key="NetLoom.Style.LinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NetLoom.Style.SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource NetLoom.Thickness.None}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="NetLoom.Style.AlertSummary" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource NetLoom.FontSize.Caption}" />
    </Style>

</ResourceDictionary>
