<Window x:Class="NetLoom.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetLoom"
        Height="700"
        Width="1100"
        MinHeight="500"
        MinWidth="800">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="14"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="MapTitleText"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="MapStatusText"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="NetLoom" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Right"
                Width="360"
                Padding="14"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="LookupTitleText"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBlock x:Name="LookupQueryLabelText"
                               Margin="0,12,0,4" />

                    <TextBox x:Name="LookupQueryTextBox"
                             KeyDown="OnLookupQueryKeyDown" />

                    <Button x:Name="LookupSearchButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Padding="14,5"
                            Click="OnLookupSearchClick" />

                    <TextBlock x:Name="LookupStatusText"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="LookupResultsLabelText"
                               Margin="0,14,0,4"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock x:Name="LookupDetailsText"
                           DockPanel.Dock="Bottom"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />

                <ListBox x:Name="LookupResultsList"
                         DisplayMemberPath="Summary"
                         SelectionChanged="OnLookupSelectionChanged" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="190"
                Padding="14"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="AlertTitleText"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AlertStatusText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AlertTransitionText"
                               Margin="0,4,0,8"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox x:Name="AlertList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MapScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="MapCanvas"
                    Width="1600"
                    Height="1000" />
        </ScrollViewer>
    </DockPanel>
</Window>
