<Window x:Class="NetLoom.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:NetLoom.Wpf.Shell"
        Height="{DynamicResource NetLoom.Shell.WindowHeight}"
        Width="{DynamicResource NetLoom.Shell.WindowWidth}"
        MinHeight="{DynamicResource NetLoom.Shell.WindowMinHeight}"
        MinWidth="{DynamicResource NetLoom.Shell.WindowMinWidth}"
        FontFamily="{DynamicResource NetLoom.FontFamily.Ui}"
        FontSize="{DynamicResource NetLoom.FontSize.Body}"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource NetLoom.Brush.Window}"
        Foreground="{DynamicResource NetLoom.Brush.TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/DeviceIcons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource NetLoom.Style.Panel}"
                Padding="{DynamicResource NetLoom.Thickness.ShellHeaderPadding}"
                BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- G1 (sprint46-mockup-gap): знак перед названием — кольцо с точкой акцентным цветом. -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Width="{DynamicResource NetLoom.Shell.BrandMarkSize}"
                          Height="{DynamicResource NetLoom.Shell.BrandMarkSize}"
                          Margin="{DynamicResource NetLoom.Thickness.EventPartGap}"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse Stroke="{DynamicResource NetLoom.Brush.Accent}"
                                 StrokeThickness="2" />
                        <Ellipse Width="{DynamicResource NetLoom.Shell.BrandDotSize}"
                                 Height="{DynamicResource NetLoom.Shell.BrandDotSize}"
                                 Fill="{DynamicResource NetLoom.Brush.Accent}" />
                    </Grid>
                    <TextBlock x:Name="ShellBrandText"
                               Style="{StaticResource NetLoom.Style.WindowTitle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ShellBreadcrumbText"
                           Grid.Column="1"
                           Margin="16,0,12,0"
                           MaxWidth="240"
                           Style="{StaticResource NetLoom.Style.MutedText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Поиск сжимается вместе с окном и не заходит под правую часть шапки. -->
                <Grid Grid.Column="2"
                      MinWidth="{DynamicResource NetLoom.Shell.SearchMinWidth}"
                      MaxWidth="{DynamicResource NetLoom.Shell.SearchMaxWidth}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <TextBox x:Name="ShellGlobalSearchTextBox"
                             Height="32"
                             Padding="30,4,54,4"
                             VerticalContentAlignment="Center"
                             TextChanged="OnShellGlobalSearchTextChanged"
                             PreviewKeyDown="OnShellGlobalSearchPreviewKeyDown" />
                    <!-- Лупа вписывается в 14×14 целиком (Stretch), раньше геометрия выходила за рамку и обрезалась. -->
                    <Path Width="14"
                          Height="14"
                          Margin="10,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{DynamicResource NetLoom.Brush.TextSecondary}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          IsHitTestVisible="False"
                          Data="{StaticResource NetLoom.Icon.ShellSearch}" />
                    <!-- Видимая подсказка, что это поиск и что в нём искать (UI_DESIGN_RULES §3). -->
                    <TextBlock x:Name="ShellGlobalSearchPlaceholderText"
                               Margin="{DynamicResource NetLoom.Thickness.SearchPlaceholderMargin}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource NetLoom.Style.MutedText}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ShellGlobalSearchTextBox}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Padding="7,2"
                            BorderBrush="{DynamicResource NetLoom.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                        <TextBlock Text="Ctrl K"
                                   Style="{StaticResource NetLoom.Style.MutedText}" />
                    </Border>
                    <Popup x:Name="ShellGlobalSearchPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ShellGlobalSearchTextBox}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Width="520"
                                MaxHeight="420"
                                Margin="0,4,0,0"
                                Padding="12"
                                Background="{DynamicResource NetLoom.Brush.Surface}"
                                BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="ShellGlobalSearchStatusText"
                                           Style="{StaticResource NetLoom.Style.MutedText}" />
                                <ListBox x:Name="ShellGlobalSearchResultsList"
                                         Margin="0,8,0,0"
                                         PreviewKeyDown="OnShellGlobalSearchPreviewKeyDown"
                                         PreviewMouseLeftButtonUp="OnShellGlobalSearchResultMouseLeftButtonUp">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                                               Margin="0,8,0,4" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,8,0">
                    <!-- Sprint 47: состояние мониторинга открывает подробности цикла опроса; во время цикла —
                         «Опрос: N / всего» и тонкая нейтральная полоса под текстом. Новых постоянных элементов нет. -->
                    <Button x:Name="ShellMonitoringDetailsButton"
                            Style="{StaticResource NetLoom.Style.FlatButton}"
                            VerticalAlignment="Center"
                            Click="OnShellMonitoringDetailsClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ShellMonitoringHeaderText" shell:LiveRegion.IsPolite="True"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center" />
                                <Path Width="{DynamicResource NetLoom.Expander.ArrowSize}"
                                      Height="{DynamicResource NetLoom.Expander.ArrowSize}"
                                      Margin="{DynamicResource NetLoom.Thickness.DropDownArrowMargin}"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource NetLoom.Brush.TextSecondary}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      IsHitTestVisible="False"
                                      Data="M 0,0 L 4,4 L 8,0" />
                            </StackPanel>
                            <ProgressBar x:Name="ShellMonitoringProgressBar"
                                         Style="{StaticResource NetLoom.Style.CycleProgressBar}"
                                         Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                         Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ShellMonitoringDetailsPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ShellMonitoringDetailsButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border x:Name="ShellMonitoringDetailsPanel"
                                Width="{DynamicResource NetLoom.Shell.MonitoringDetailsWidth}"
                                Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                Padding="{DynamicResource NetLoom.Thickness.PopupPadding}"
                                Background="{DynamicResource NetLoom.Brush.Surface}"
                                BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                                BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                CornerRadius="{DynamicResource NetLoom.Radius.Card}"
                                Focusable="True"
                                FocusVisualStyle="{x:Null}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                PreviewKeyDown="OnShellMonitoringDetailsPreviewKeyDown">
                            <StackPanel>
                                <TextBlock x:Name="ShellMonitoringDetailsTitleText" shell:LiveRegion.IsPolite="True"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ProgressBar x:Name="ShellMonitoringDetailsProgressBar"
                                             Style="{StaticResource NetLoom.Style.CycleProgressBar}"
                                             Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="ShellMonitoringDetailsLastCycleText"
                                           Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.SubsectionLabel}"
                                           Visibility="Collapsed" />
                                <!-- Имя и адрес текущего устройства длинные — отдельной строкой во всю ширину, а не в столбце значений. -->
                                <StackPanel x:Name="ShellMonitoringCurrentPanel"
                                            Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="ShellMonitoringCurrentLabelText"
                                               Style="{StaticResource NetLoom.Style.MutedText}" />
                                    <TextBlock x:Name="ShellMonitoringCurrentValueText"
                                               Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ShellMonitoringDetailsEmptyText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <ItemsControl x:Name="ShellMonitoringDetailsFieldsList"
                                              Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{DynamicResource NetLoom.Thickness.ListRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                                           Margin="{DynamicResource NetLoom.Thickness.TableCellGapRight}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           HorizontalAlignment="Right"
                                                           TextAlignment="Right"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Причина отказа действия или ошибка мониторинга видна текстом рядом с кнопкой (§8). -->
                                <TextBlock x:Name="ShellMonitoringDetailsMessageText"
                                           Text="{Binding Text, ElementName=MonitoringMessageText}"
                                           Style="{Binding Style, ElementName=MonitoringMessageText}"
                                           Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ShellMonitoringCycleActionButton"
                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                        Margin="{DynamicResource NetLoom.Thickness.ButtonRowGap}"
                                        HorizontalAlignment="Left"
                                        Click="OnShellMonitoringCycleActionClick" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="ShellMonitoringStartButton"
                            Style="{StaticResource NetLoom.Style.SecondaryButton}"
                            Margin="12,0,0,0"
                            Click="OnMonitoringStartClick" />
                    <Button x:Name="ShellMonitoringStopButton"
                            Style="{StaticResource NetLoom.Style.SecondaryButton}"
                            Margin="12,0,0,0"
                            Visibility="Collapsed"
                            Click="OnMonitoringStopClick" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DiscoveryProfileLabelText"
                               Visibility="Collapsed" />
                    <!-- G3 (sprint46-mockup-gap): профиль — небольшой чип со скруглением «пилюля», ширина по содержимому
                         в пределах ProfileMinWidth…ProfileWidth; полное имя — в подсказке. -->
                    <ComboBox x:Name="DiscoveryProfileComboBox"
                              MinWidth="{DynamicResource NetLoom.Shell.ProfileMinWidth}"
                              MaxWidth="{DynamicResource NetLoom.Shell.ProfileWidth}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}">
                        <ComboBox.Resources>
                            <StaticResource x:Key="NetLoom.Radius.Control" ResourceKey="NetLoom.Radius.Pill" />
                        </ComboBox.Resources>
                    </ComboBox>
                    <Button x:Name="ShellProfileAddButton"
                            Visibility="Collapsed"
                            Click="OnShellProfileManageClick" />
                    <TextBlock x:Name="ShellProfileStatusText"
                               Visibility="Collapsed" />
                    <Button x:Name="ShellThemeButton"
                            Visibility="Collapsed"
                            Click="OnShellThemeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ShellWorkspaceGrid"
              Grid.Row="1"
              SizeChanged="OnShellWorkspaceSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource NetLoom.Shell.RailWidth}" />
                <ColumnDefinition Width="{DynamicResource NetLoom.Shell.SidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ShellInspectorColumn"
                                  Width="{DynamicResource NetLoom.Shell.InspectorWidth}"
                                  MinWidth="0"
                                  MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource NetLoom.Brush.ShellRail}"
                    BorderBrush="{DynamicResource NetLoom.Brush.ShellRailBorder}"
                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderRight}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="{DynamicResource NetLoom.Thickness.ShellRailPadding}">
                        <Button x:Name="ShellMapButton"
                                Width="44"
                                Height="44"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Style="{StaticResource NetLoom.Style.NavigationButton}"
                                Click="OnShellMapClick">
                            <Grid>
                                <Path Style="{StaticResource NetLoom.Style.NavigationIcon}"
                                      Data="{StaticResource NetLoom.Icon.ShellMap}" />
                                <TextBlock x:Name="ShellMapButtonText"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="ShellEquipmentButton"
                                Width="44"
                                Height="44"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Style="{StaticResource NetLoom.Style.NavigationButton}"
                                Click="OnShellEquipmentClick">
                            <Grid>
                                <Path Style="{StaticResource NetLoom.Style.NavigationIcon}"
                                      Data="{StaticResource NetLoom.Icon.ShellEquipment}" />
                                <TextBlock x:Name="ShellEquipmentButtonText"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="ShellMonitoringButton"
                                Visibility="Collapsed"
                                Click="OnShellMonitoringClick">
                            <TextBlock x:Name="ShellMonitoringButtonText"
                                       Visibility="Collapsed" />
                        </Button>
                        <Button x:Name="ShellAlertsButton"
                                Width="44"
                                Height="44"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Style="{StaticResource NetLoom.Style.NavigationButton}"
                                Click="OnShellAlertsClick">
                            <Grid>
                                <Path Style="{StaticResource NetLoom.Style.NavigationIcon}"
                                      Data="{StaticResource NetLoom.Icon.ShellAlerts}" />
                                <TextBlock x:Name="ShellAlertsButtonText"
                                           Visibility="Collapsed" />
                                <Border x:Name="ShellAlertsBadge"
                                        Style="{StaticResource NetLoom.Style.NavigationBadge}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-5,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ShellAlertsBadgeText"
                                               Foreground="{DynamicResource NetLoom.Brush.Window}"
                                               FontSize="{DynamicResource NetLoom.Navigation.BadgeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextBlock.LineStackingStrategy="BlockLineHeight"
                                               TextBlock.LineHeight="{DynamicResource NetLoom.Navigation.BadgeFontSize}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="{DynamicResource NetLoom.Type.BadgeOpticalOffsetY}" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="ShellDiscoveryButton"
                                Width="44"
                                Height="44"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Style="{StaticResource NetLoom.Style.NavigationButton}"
                                Click="OnShellDiscoveryClick">
                            <Grid>
                                <Path Style="{StaticResource NetLoom.Style.NavigationIcon}"
                                      Data="{StaticResource NetLoom.Icon.ShellDiscovery}" />
                                <TextBlock x:Name="ShellDiscoveryButtonText"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="ShellSearchButton"
                                Visibility="Collapsed"
                                Click="OnShellSearchClick">
                            <TextBlock x:Name="ShellSearchButtonText"
                                       Visibility="Collapsed" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="{DynamicResource NetLoom.Thickness.ShellRailPadding}">
                        <Button x:Name="ShellSettingsButton"
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                Style="{StaticResource NetLoom.Style.NavigationButton}"
                                Click="OnShellSettingsClick">
                            <Grid>
                                <Path Style="{StaticResource NetLoom.Style.NavigationIcon}"
                                      Data="{StaticResource NetLoom.Icon.ShellSettings}" />
                                <TextBlock x:Name="ShellSettingsButtonText"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="ShellMonitoringRailTitleText" />
                            <TextBlock x:Name="ShellMonitoringRailText" />
                            <TextBlock x:Name="ShellAlertCountText" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="ShellSectionSurface"
                    SizeChanged="OnShellSectionSurfaceSizeChanged"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Style="{StaticResource NetLoom.Style.Panel}"
                    BorderThickness="0">
                <Grid>
                    <ScrollViewer x:Name="ShellMapSidebarPanel"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                            <TextBlock x:Name="MapInteractionModeLabelText"
                                       Visibility="Collapsed" />
                            <Border x:Name="MapEditModeIndicator"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="MapEditModeIndicatorText" />
                                    <TextBlock x:Name="MapEditModeHintText" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ShellMapActionsTitleText"
                                       Visibility="Collapsed" />
                            <Button x:Name="MapHelpButton"
                                    Visibility="Collapsed"
                                    Click="OnMapHelpClick" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ShellEquipmentSidebarPanel"
                          Visibility="Collapsed"
                          Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="EquipmentTitleText"
                                           Style="{StaticResource NetLoom.Style.SectionTitle}" />
                                <TextBlock x:Name="EquipmentSummaryText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="EquipmentExportCsvButton"
                                    Grid.Column="1"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Click="OnEquipmentExportCsvClick" />
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EquipmentFilterTextBox"
                                     Grid.Column="0"
                                     Padding="{DynamicResource NetLoom.Thickness.FilterFieldPadding}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnEquipmentFilterTextChanged" />
                            <!-- E3: лупа в поле фильтра, как в поиске шапки. -->
                            <Path Grid.Column="0"
                                  Width="14"
                                  Height="14"
                                  Margin="{DynamicResource NetLoom.Thickness.FilterIconMargin}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource NetLoom.Brush.TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  IsHitTestVisible="False"
                                  Data="{StaticResource NetLoom.Icon.ShellSearch}" />
                            <!-- Подсказка фильтра по макету netloom-v2-2-oborudovanie. -->
                            <TextBlock x:Name="EquipmentFilterPlaceholderText"
                                       Grid.Column="0"
                                       Margin="{DynamicResource NetLoom.Thickness.FilterPlaceholderMargin}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource NetLoom.Style.MutedText}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EquipmentFilterTextBox}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="1"
                                    Style="{StaticResource NetLoom.Style.SegmentedGroup}"
                                    Margin="{DynamicResource NetLoom.Thickness.FieldGapLeft}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="EquipmentFilterAllButton"
                                            Tag="All"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnEquipmentFilterModeClick" />
                                    <Button x:Name="EquipmentFilterProblemsButton"
                                            Tag="Problems"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnEquipmentFilterModeClick" />
                                    <Button x:Name="EquipmentFilterNoDataButton"
                                            Tag="NoData"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnEquipmentFilterModeClick" />
                                    <Button x:Name="EquipmentFilterManualButton"
                                            Tag="Manual"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnEquipmentFilterModeClick" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                Style="{StaticResource NetLoom.Style.Panel}"
                                BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                CornerRadius="{DynamicResource NetLoom.Radius.Panel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="12,8"
                                      ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="{DynamicResource NetLoom.Equipment.CategoryColumnWidth}" />
                                        <ColumnDefinition Width="{DynamicResource NetLoom.Equipment.DescriptionColumnWidth}" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="0.55*" MinWidth="{DynamicResource NetLoom.Equipment.ConnectionsColumnMinWidth}" />
                                        <ColumnDefinition Width="0.75*" MinWidth="{DynamicResource NetLoom.Equipment.UpdatedColumnMinWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EquipmentNameHeaderText"
                                               Grid.Column="1"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentAddressHeaderText"
                                               Grid.Column="2"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentCategoryHeaderText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Grid.Column="3"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentDescriptionHeaderText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Grid.Column="4"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentLocationHeaderText"
                                               Grid.Column="5"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentConnectionsHeaderText"
                                               Grid.Column="6"
                                               HorizontalAlignment="Right"
                                               Margin="{DynamicResource NetLoom.Thickness.TableCellGapRight}"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                    <TextBlock x:Name="EquipmentUpdatedHeaderText"
                                               Grid.Column="7"
                                               Style="{StaticResource NetLoom.Style.TableHeader}" />
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="EquipmentList"
                                          Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource NetLoom.Style.EquipmentRowButton}"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="12,8"
                                                        Margin="0"
                                                        Tag="{Binding DeviceId}"
                                                        IsEnabled="{Binding IsSelectable}"
                                                        Click="OnShellEquipmentDeviceClick">
                                                    <Grid ClipToBounds="True">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="{DynamicResource NetLoom.Equipment.CategoryColumnWidth}" />
                                                            <ColumnDefinition Width="{DynamicResource NetLoom.Equipment.DescriptionColumnWidth}" />
                                                            <ColumnDefinition Width="1.35*" />
                                                            <ColumnDefinition Width="0.55*" MinWidth="{DynamicResource NetLoom.Equipment.ConnectionsColumnMinWidth}" />
                                                            <ColumnDefinition Width="0.75*" MinWidth="{DynamicResource NetLoom.Equipment.UpdatedColumnMinWidth}" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- E2: проблема — значком ⚠ / × по грамматике статусов (§2), норма — серая точка, нет данных — «—». -->
                                                        <Grid Grid.Column="0"
                                                              VerticalAlignment="Center">
                                                            <TextBlock x:Name="EquipmentStateGlyphText"
                                                                       Text="{Binding StateGlyph}"
                                                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                                                       VerticalAlignment="Center" />
                                                            <Path x:Name="EquipmentStateIcon"
                                                                  Style="{StaticResource NetLoom.Style.MapNodeStatusIcon}"
                                                                  HorizontalAlignment="Left"
                                                                  Visibility="Collapsed" />
                                                        </Grid>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock x:Name="EquipmentProblemText"
                                                                       Text="{Binding ProblemText}"
                                                                       Visibility="{Binding ProblemVisibility}"
                                                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                                                       FontSize="{DynamicResource NetLoom.FontSize.Caption}"
                                                                       Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ProblemText}" />
                                                            <TextBlock x:Name="EquipmentUnconfirmedText"
                                                                       Text="{Binding UnconfirmedText}"
                                                                       Visibility="{Binding UnconfirmedVisibility}"
                                                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                                                       FontSize="{DynamicResource NetLoom.FontSize.Caption}"
                                                                       Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding UnconfirmedHint}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Address}"
                                                                   Style="{StaticResource NetLoom.Style.MonoText}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Address}" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Category}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Category}" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding Description}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Description}" />
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding Location}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Location}" />
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding Connections}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="{DynamicResource NetLoom.Thickness.TableCellGapRight}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7"
                                                                   Text="{Binding Updated}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Updated}" />
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCriticalProblem}"
                                                                 Value="True">
                                                        <Setter TargetName="EquipmentStateGlyphText"
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Data"
                                                                Value="{StaticResource NetLoom.Icon.StatusCritical}" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Stroke"
                                                                Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                        <Setter TargetName="EquipmentStateGlyphText"
                                                                Property="Foreground"
                                                                Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                        <Setter TargetName="EquipmentProblemText"
                                                                Property="Foreground"
                                                                Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarningProblem}"
                                                                 Value="True">
                                                        <Setter TargetName="EquipmentStateGlyphText"
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Data"
                                                                Value="{StaticResource NetLoom.Icon.StatusWarning}" />
                                                        <Setter TargetName="EquipmentStateIcon"
                                                                Property="Stroke"
                                                                Value="{DynamicResource NetLoom.Brush.Warning}" />
                                                        <Setter TargetName="EquipmentStateGlyphText"
                                                                Property="Foreground"
                                                                Value="{DynamicResource NetLoom.Brush.Warning}" />
                                                        <Setter TargetName="EquipmentProblemText"
                                                                Property="Foreground"
                                                                Value="{DynamicResource NetLoom.Brush.Warning}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="ShellMonitoringSidebarPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                            <TextBlock x:Name="MonitoringTitleText"
                                       Style="{StaticResource NetLoom.Style.SectionTitle}" />

                            <Border x:Name="MonitoringStatusCard"
                                    Style="{StaticResource NetLoom.Style.OperatorCard}"
                                    Margin="{DynamicResource NetLoom.Thickness.CardGapTop}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MonitoringStateGlyphText"
                                                   Style="{StaticResource NetLoom.Style.StatusGlyph}" />
                                        <TextBlock x:Name="MonitoringStateValueText"
                                                   Grid.Column="1"
                                                   Style="{StaticResource NetLoom.Style.StatusEmphasis}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="MonitoringStateLabelText"
                                                   Visibility="Collapsed" />
                                    </Grid>

                                    <Grid Margin="{DynamicResource NetLoom.Thickness.CardSectionGap}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MonitoringActiveTargetLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBlock x:Name="MonitoringActiveTargetValueText"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MonitoringSelectedDeviceLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBlock x:Name="MonitoringSelectedDeviceValueText"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="{DynamicResource NetLoom.Thickness.CardGapTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource NetLoom.Grid.ButtonGap}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MonitoringStartButton"
                                        Grid.Column="0"
                                        Style="{StaticResource NetLoom.Style.SidebarActionButton}"
                                        Click="OnMonitoringStartClick" />
                                <Button x:Name="MonitoringStopButton"
                                        Grid.Column="0"
                                        Style="{StaticResource NetLoom.Style.SidebarActionButton}"
                                        Click="OnMonitoringStopClick" />
                                <Button x:Name="MonitoringPollNowButton"
                                        Grid.Column="2"
                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnMonitoringPollNowClick" />
                            </Grid>

                            <TextBlock x:Name="MonitoringRecentActivityTitleText"
                                       Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}" />

                            <Border Style="{StaticResource NetLoom.Style.OperatorCard}"
                                    Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MonitoringLastPollLabelText"
                                               Grid.Row="0"
                                               Grid.Column="0"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                    <TextBlock x:Name="MonitoringLastPollValueText"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="MonitoringLastRefreshLabelText"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}"
                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}" />
                                    <TextBlock x:Name="MonitoringLastRefreshValueText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Expander x:Name="MonitoringExpander"
                                      IsExpanded="False"
                                      Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}"
                                      Style="{StaticResource NetLoom.Style.OperatorExpander}">
                                <Expander.Header>
                                    <TextBlock x:Name="MonitoringParametersTitleText"
                                               Style="{StaticResource NetLoom.Style.SubsectionLabel}" />
                                </Expander.Header>
                                <StackPanel Margin="{DynamicResource NetLoom.Thickness.ExpanderContent}">
                                    <StackPanel>
                                        <TextBlock x:Name="MonitoringTargetAddressLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   TextWrapping="Wrap" />
                                        <TextBox x:Name="MonitoringTargetAddressTextBox" />
                                    </StackPanel>

                                    <Grid Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MonitoringIntervalLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringIntervalTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MonitoringVersionLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <Border x:Name="MonitoringVersionReadOnlyBorder"
                                                    MinHeight="{DynamicResource NetLoom.Control.MinHeight}"
                                                    Background="{DynamicResource NetLoom.Brush.SurfaceMuted}"
                                                    BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                                    CornerRadius="{DynamicResource NetLoom.Radius.Control}"
                                                    Padding="{DynamicResource NetLoom.Thickness.ControlPaddingOptical}"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="MonitoringVersionValueText"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock x:Name="MonitoringVersionNoProfileText"
                                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="{DynamicResource NetLoom.Thickness.GapXsTop}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MonitoringPortLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringPortTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MonitoringTimeoutLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringTimeoutTextBox" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MonitoringRetriesLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringRetriesTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MonitoringMaxRepetitionsLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringMaxRepetitionsTextBox" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MonitoringErrorThresholdLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringErrorThresholdTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MonitoringDiscardThresholdLabelText"
                                                       Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                            <TextBox x:Name="MonitoringDiscardThresholdTextBox" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <TextBlock x:Name="MonitoringKindsLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                        <WrapPanel>
                                            <CheckBox x:Name="MonitoringKindLldpCheckBox" />
                                            <CheckBox x:Name="MonitoringKindCdpCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                            <CheckBox x:Name="MonitoringKindFdbCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                            <CheckBox x:Name="MonitoringKindArpCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                            <CheckBox x:Name="MonitoringKindHealthCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                            <CheckBox x:Name="MonitoringKindInterfaceCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                            <CheckBox x:Name="MonitoringKindStpCheckBox"
                                                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Button x:Name="MonitoringRefreshTopologyButton"
                                            Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                            Margin="{DynamicResource NetLoom.Thickness.ButtonRowGap}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnMonitoringRefreshTopologyClick" />

                                    <TextBlock x:Name="MonitoringHintText"
                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                               Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <TextBlock x:Name="MonitoringMessageText"
                                       Style="{StaticResource NetLoom.Style.StatusEmphasis}"
                                       Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ShellAlertsSidebarPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                            <TextBlock x:Name="AlertTitleText"
                                       Style="{StaticResource NetLoom.Style.SectionTitle}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                <Border Background="{DynamicResource NetLoom.Brush.CriticalSoft}"
                                        CornerRadius="{DynamicResource NetLoom.Radius.Pill}"
                                        Padding="{DynamicResource NetLoom.Thickness.PillPadding}">
                                    <TextBlock x:Name="AlertCriticalCountText"
                                               Foreground="{DynamicResource NetLoom.Brush.Critical}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource NetLoom.FontSize.Caption}" />
                                </Border>
                                <Border Background="{DynamicResource NetLoom.Brush.WarningSoft}"
                                        CornerRadius="{DynamicResource NetLoom.Radius.Pill}"
                                        Padding="{DynamicResource NetLoom.Thickness.PillPadding}"
                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}">
                                    <TextBlock x:Name="AlertWarningCountText"
                                               Foreground="{DynamicResource NetLoom.Brush.Warning}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource NetLoom.FontSize.Caption}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="AlertStatusText" shell:LiveRegion.IsPolite="True"
                                       Visibility="Collapsed"
                                       Style="{StaticResource NetLoom.Style.AlertSummary}"
                                       Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                       TextWrapping="Wrap" />

                            <ItemsControl x:Name="AlertList"
                                          Focusable="False"
                                          Margin="{DynamicResource NetLoom.Thickness.CardGapTop}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AlertCard"
                                                Style="{StaticResource NetLoom.Style.OperatorCard}"
                                                Margin="{DynamicResource NetLoom.Thickness.ListRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{DynamicResource NetLoom.Alert.StripeWidth}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="AlertSeverityStripe"
                                                        Grid.Column="0"
                                                        Background="{DynamicResource NetLoom.Brush.Warning}"
                                                        CornerRadius="{DynamicResource NetLoom.Radius.AlertStripe}" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="{DynamicResource NetLoom.Thickness.CardBodyInset}">
                                                    <DockPanel>
                                                        <Border x:Name="AlertSeverityBadge"
                                                                DockPanel.Dock="Left"
                                                                Background="{DynamicResource NetLoom.Brush.WarningSoft}"
                                                                CornerRadius="{DynamicResource NetLoom.Radius.Pill}"
                                                                Padding="{DynamicResource NetLoom.Thickness.PillPadding}">
                                                            <TextBlock x:Name="AlertSeverityRowText"
                                                                       Text="{Binding SeverityText}"
                                                                       Foreground="{DynamicResource NetLoom.Brush.Warning}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{DynamicResource NetLoom.FontSize.Caption}" />
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding TimeText}"
                                                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource NetLoom.Style.CardTitle}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Scope}"
                                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Reason}"
                                                               x:Name="AlertReasonText"
                                                               Foreground="{DynamicResource NetLoom.Brush.Warning}"
                                                               FontWeight="SemiBold"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                               TextWrapping="Wrap" />
                                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="{Binding ShowOnMapText}"
                                                                Tag="{Binding PrimaryPhysicalLinkId}"
                                                                HorizontalAlignment="Left"
                                                                Style="{StaticResource NetLoom.Style.LinkButton}"
                                                                Click="OnAlertShowOnMapClick" />
                                                        <!-- A2: «› Технические детали» ссылкой без фона, как в макете netloom-v2-4. -->
                                                        <Expander Grid.Column="1"
                                                                  Header="{Binding TechnicalDetailsLabel}"
                                                                  IsExpanded="{Binding IsTechnicalDetailsExpanded, Mode=TwoWay}">
                                                            <TextBlock Text="{Binding TechnicalDetails}"
                                                                       Style="{StaticResource NetLoom.Style.MonoText}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="{DynamicResource NetLoom.Thickness.ExpanderContent}" />
                                                        </Expander>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- A2 (sprint46-mockup-gap): выбранная карточка — рамка цвета выделения, как в макете netloom-v2-4;
                                                 цвет важности (полоса, чип) не меняется (§2 «выделение не перекрашивает статус»). -->
                                            <DataTrigger Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter TargetName="AlertCard"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource NetLoom.Brush.Selection}" />
                                                <Setter TargetName="AlertCard"
                                                        Property="BorderThickness"
                                                        Value="{DynamicResource NetLoom.Thickness.CardSelectedBorder}" />
                                                <Setter TargetName="AlertCard"
                                                        Property="Padding"
                                                        Value="{DynamicResource NetLoom.Thickness.CardSelectedPadding}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCritical}"
                                                         Value="True">
                                                <Setter TargetName="AlertSeverityStripe"
                                                        Property="Background"
                                                        Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                <Setter TargetName="AlertSeverityBadge"
                                                        Property="Background"
                                                        Value="{DynamicResource NetLoom.Brush.CriticalSoft}" />
                                                <Setter TargetName="AlertSeverityRowText"
                                                        Property="Foreground"
                                                        Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                <Setter TargetName="AlertReasonText"
                                                        Property="Foreground"
                                                        Value="{DynamicResource NetLoom.Brush.Critical}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>


                    <Grid x:Name="ShellDiscoverySidebarPanel"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource NetLoom.Discovery.FormWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                                <TextBlock x:Name="DiscoveryTitleText"
                                           Style="{StaticResource NetLoom.Style.SectionTitle}" />

                                <!-- D2 (sprint46-mockup-gap): подпись группы над карточкой, в карточке одна строка
                                     «имя · SNMP v2c» и ссылка «Изменить в настройках» на приглушённом фоне, как в макете netloom-v2-5. -->
                                <TextBlock x:Name="DiscoverySidebarProfileLabelText"
                                           Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.CardGapTop}" />
                                <Border x:Name="DiscoveryProfileCard"
                                        Style="{StaticResource NetLoom.Style.OperatorCard}"
                                        Background="{DynamicResource NetLoom.Brush.SurfaceMuted}"
                                        Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="DiscoveryProfileSummaryText"
                                                       Style="{StaticResource NetLoom.Style.CardTitle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="DiscoveryProfileHintText"
                                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                                       Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="DiscoveryProfileAddButton"
                                                Grid.Column="1"
                                                Style="{StaticResource NetLoom.Style.LinkButton}"
                                                Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                                VerticalAlignment="Center"
                                                Click="OnShellProfileManageClick" />
                                    </Grid>
                                </Border>

                                <!-- D3: группа «Диапазон адресов», маска — в ширину первого столбца, как в макете netloom-v2-5. -->
                                <TextBlock x:Name="DiscoveryRangeTitleText"
                                           Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}" />
                                <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="DiscoveryStartAddressLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                        <TextBox x:Name="DiscoveryStartAddressTextBox"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=DiscoveryStartAddressLabelText}"
                                                 FontFamily="{DynamicResource NetLoom.FontFamily.Mono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="DiscoveryEndAddressLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                        <TextBox x:Name="DiscoveryEndAddressTextBox"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=DiscoveryEndAddressLabelText}"
                                                 FontFamily="{DynamicResource NetLoom.FontFamily.Mono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}">
                                        <TextBlock x:Name="DiscoverySubnetMaskLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                        <TextBox x:Name="DiscoverySubnetMaskTextBox"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=DiscoverySubnetMaskLabelText}"
                                                 FontFamily="{DynamicResource NetLoom.FontFamily.Mono}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="{DynamicResource NetLoom.Thickness.ButtonRowGap}">
                                    <Button x:Name="DiscoveryStartButton"
                                            Style="{StaticResource NetLoom.Style.SidebarActionButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnDiscoveryStartClick" />
                                    <Button x:Name="DiscoveryStopButton"
                                            Style="{StaticResource NetLoom.Style.SidebarSecondaryActionButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnDiscoveryStopClick" />
                                </Grid>

                                <TextBlock x:Name="DiscoveryWarningText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DiscoveryMessageText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                           TextWrapping="Wrap" />
                                <!-- D3 (sprint46-mockup-gap): «Последний запуск» в форме, как в макете netloom-v2-5;
                                     состояние берётся из той же строки, что и в панели результатов. -->
                                <TextBlock x:Name="DiscoveryLastRunTitleText"
                                           Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}" />
                                <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text, ElementName=DiscoveryStateLabelText}"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text, ElementName=DiscoveryStateValueText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <StackPanel x:Name="DiscoveryRunSummaryPanel"
                                            Visibility="Collapsed">
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunStartedLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunStartedValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunDurationLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunDurationValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunCheckedLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunCheckedValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunFoundLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunFoundValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunErrorsLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunErrorsValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiscoveryRunKnownUnchangedLabelText"
                                                   Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoveryRunKnownUnchangedValueText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1"
                              Background="{DynamicResource NetLoom.Brush.Canvas}">
                            <!-- D4: пустое состояние со значком на приглушённой карточке, как в макете netloom-v2-5. -->
                            <Border x:Name="DiscoveryResultsEmptyCard"
                                    Width="500"
                                    MaxWidth="500"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NetLoom.Style.OperatorCard}"
                                    Background="{DynamicResource NetLoom.Brush.SurfaceMuted}">
                                <StackPanel Margin="24"
                                            HorizontalAlignment="Center">
                                    <Path Width="{DynamicResource NetLoom.Navigation.IconSize}"
                                          Height="{DynamicResource NetLoom.Navigation.IconSize}"
                                          Margin="{DynamicResource NetLoom.Thickness.EmptyStateIconMargin}"
                                          HorizontalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource NetLoom.Brush.TextSecondary}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{StaticResource NetLoom.Icon.ShellDiscovery}" />
                                    <TextBlock x:Name="DiscoveryEmptyTitleText"
                                               Style="{StaticResource NetLoom.Style.CardTitle}"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="DiscoveryEmptyBodyText"
                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="DiscoveryResultsPanel"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                                    <Expander x:Name="DiscoveryExpander"
                                              IsExpanded="True"
                                              Style="{StaticResource NetLoom.Style.OperatorExpander}">
                                        <Expander.Header>
                                            <TextBlock x:Name="DiscoveryCandidatesLabelText"
                                                       Style="{StaticResource NetLoom.Style.SidebarSectionLabel}" />
                                        </Expander.Header>
                                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.ExpanderContent}">
                                            <Border Style="{StaticResource NetLoom.Style.OperatorCard}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="DiscoveryStateLabelText"
                                                               Grid.Row="0"
                                                               Grid.Column="0"
                                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                                    <StackPanel Grid.Row="0"
                                                                Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock x:Name="DiscoveryStateGlyphText"
                                                                   Style="{StaticResource NetLoom.Style.StatusGlyph}" />
                                                        <TextBlock x:Name="DiscoveryStateValueText" shell:LiveRegion.IsPolite="True"
                                                                   Style="{StaticResource NetLoom.Style.StatusEmphasis}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="DiscoveryProgressLabelText"
                                                               Grid.Row="1"
                                                               Grid.Column="0"
                                                               Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}" />
                                                    <TextBlock x:Name="DiscoveryProgressValueText"
                                                               Grid.Row="1"
                                                               Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="DiscoveryCurrentAddressLabelText"
                                                               Grid.Row="2"
                                                               Grid.Column="0"
                                                               Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}" />
                                                    <TextBlock x:Name="DiscoveryCurrentAddressValueText"
                                                               Grid.Row="2"
                                                               Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                               FontFamily="{DynamicResource NetLoom.FontFamily.Mono}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="DiscoveryPhaseLabelText"
                                                               Grid.Row="3"
                                                               Grid.Column="0"
                                                               Style="{StaticResource NetLoom.Style.FieldLabel}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}" />
                                                    <TextBlock x:Name="DiscoveryPhaseValueText"
                                                               Grid.Row="3"
                                                               Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>


                                        </StackPanel>
                                    </Expander>
                                    <StackPanel x:Name="DiscoveryInboxPanel"
                                                Margin="{DynamicResource NetLoom.Thickness.GroupGap}">
                                        <TextBlock x:Name="DiscoveryInboxTitleText"
                                                   Style="{StaticResource NetLoom.Style.GroupTitle}" />
                                        <TextBlock x:Name="DiscoveryInboxSummaryText"
                                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                                   Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="DiscoveryInboxEmptyText"
                                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                                   Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel x:Name="DiscoveryInboxActionsBar"
                                                    Visibility="Collapsed"
                                                    Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}">
                                            <!-- Sprint 48: итог действия («Принято: N») — рядом с числом выбранных, у кнопок, а не в форме слева. -->
                                            <WrapPanel>
                                                <TextBlock x:Name="DiscoveryInboxSelectedText"
                                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <TextBlock x:Name="DiscoveryInboxResultText"
                                                           shell:LiveRegion.IsPolite="True"
                                                           Visibility="Collapsed"
                                                           Margin="{DynamicResource NetLoom.Thickness.FieldGapLeft}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextWrapping="Wrap" />
                                            </WrapPanel>
                                            <WrapPanel Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                                <shell:InertButton x:Name="DiscoveryInboxAcceptButton"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Margin="{DynamicResource NetLoom.Thickness.DiscoveryInboxAction}"
                                                        Click="OnDiscoveryInboxAcceptClick" />
                                                <shell:InertButton x:Name="DiscoveryInboxIgnoreButton"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Margin="{DynamicResource NetLoom.Thickness.DiscoveryInboxAction}"
                                                        Click="OnDiscoveryInboxIgnoreClick" />
                                                <shell:InertButton x:Name="DiscoveryInboxUnmanagedButton"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Margin="{DynamicResource NetLoom.Thickness.DiscoveryInboxAction}"
                                                        Click="OnDiscoveryInboxUnmanagedClick" />
                                                <shell:InertButton x:Name="DiscoveryInboxPlacementButton"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Margin="{DynamicResource NetLoom.Thickness.DiscoveryInboxAction}"
                                                        Click="OnDiscoveryInboxPlacementClick" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <ItemsControl x:Name="DiscoveryInboxGroupsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Style="{StaticResource NetLoom.Style.OperatorExpander}"
                                                              Margin="{DynamicResource NetLoom.Thickness.GroupGap}"
                                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Header}"
                                                                       Style="{StaticResource NetLoom.Style.SidebarSectionLabel}" />
                                                        </Expander.Header>
                                                        <!-- Sprint 48: «Выбрать все» — в содержимом группы: в заголовке стрелка раскрытия вставала между строками. -->
                                                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.ExpanderContent}">
                                                            <CheckBox Content="{Binding SelectAllText}"
                                                                      AutomationProperties.Name="{Binding SelectAllAutomationName}"
                                                                      IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                                                      IsThreeState="True">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasDiscoveryInboxActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource NetLoom.Style.OperatorCard}"
                                                                                Margin="{DynamicResource NetLoom.Thickness.ListRow}"
                                                                                ToolTip="{Binding FullReason}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                          AutomationProperties.Name="{Binding SelectAutomationName}"
                                                                                          Margin="{DynamicResource NetLoom.Thickness.DiscoveryInboxSelection}"
                                                                                          VerticalAlignment="Top">
                                                                                    <CheckBox.Style>
                                                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding HasDiscoveryInboxActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </CheckBox.Style>
                                                                                </CheckBox>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Address}"
                                                                                           Width="{DynamicResource NetLoom.Width.DiscoveryInboxAddress}"
                                                                                           Style="{StaticResource NetLoom.Style.MonoText}" />
                                                                                <StackPanel Grid.Column="2"
                                                                                            Margin="{DynamicResource NetLoom.Thickness.InlineGap}">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{Binding Reason}"
                                                                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                                                                               TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{Binding ResolutionText}" TextWrapping="Wrap">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NetLoom.Style.MutedText}">
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding ResolutionText}" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <TextBlock Text="{Binding Completeness}" TextWrapping="Wrap">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NetLoom.Style.MutedText}">
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding Completeness}" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="3"
                                                                                        Content="{Binding RetryText}"
                                                                                        AutomationProperties.Name="{Binding RetryAutomationName}"
                                                                                        Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                                                                        VerticalAlignment="Top"
                                                                                        IsEnabled="{Binding DiscoveryInboxCanRetry, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                        Click="OnDiscoveryInboxRetryClick">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource NetLoom.Style.LinkButton}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasRowAction}" Value="False">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                                <MultiDataTrigger>
                                                                                                    <MultiDataTrigger.Conditions>
                                                                                                        <Condition Binding="{Binding CanUndoIgnore}" Value="True" />
                                                                                                        <Condition Binding="{Binding HasDiscoveryInboxActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                                                                                                    </MultiDataTrigger.Conditions>
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </MultiDataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>


                    <ScrollViewer x:Name="ShellSearchSidebarPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <DockPanel Margin="{DynamicResource NetLoom.Thickness.SidebarInner}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="LookupTitleText"
                                           Style="{StaticResource NetLoom.Style.SectionTitle}" />

                                <TextBlock x:Name="LookupQueryLabelText"
                                           Style="{StaticResource NetLoom.Style.FieldLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}" />

                                <TextBox x:Name="LookupQueryTextBox"
                                         KeyDown="OnLookupQueryKeyDown" />

                                <Button x:Name="LookupSearchButton"
                                        Margin="{DynamicResource NetLoom.Thickness.ButtonRowGap}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnLookupSearchClick" />

                                <TextBlock x:Name="LookupStatusText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="{DynamicResource NetLoom.Thickness.StatusTop}"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="LookupResultsLabelText"
                                           Style="{StaticResource NetLoom.Style.SubsectionLabel}"
                                           Margin="{DynamicResource NetLoom.Thickness.SubsectionLabel}" />
                            </StackPanel>

                            <TextBlock x:Name="LookupDetailsText"
                                       DockPanel.Dock="Bottom"
                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                       Margin="{DynamicResource NetLoom.Thickness.StatusTop}"
                                       TextWrapping="Wrap" />

                            <ListBox x:Name="LookupResultsList"
                                     DisplayMemberPath="Summary"
                                     SelectionChanged="OnLookupSelectionChanged" />
                        </DockPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ShellSettingsSidebarPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ShellSettingsContent"
                                    MaxWidth="{DynamicResource NetLoom.Settings.ContentMaxWidth}"
                                    HorizontalAlignment="Left"
                                    Margin="{DynamicResource NetLoom.Thickness.PanelPadding}">
                            <TextBlock x:Name="ShellSettingsTitleText"
                                       Style="{StaticResource NetLoom.Style.SectionTitle}" />

                            <Grid Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ShellProfileSettingsTitleText"
                                           Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ShellProfileSettingsAddButton"
                                        Grid.Column="1"
                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                        Click="OnShellProfileSettingsAddClick" />
                            </Grid>

                            <TextBlock x:Name="ShellProfileSettingsSummaryText"
                                       Style="{StaticResource NetLoom.Style.MutedText}"
                                       Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                       TextWrapping="Wrap" />

                            <!-- S1: профили — плоские карточки без рамки выбора списка, как в макете netloom-v2-6. -->
                            <ListBox x:Name="ShellProfileSettingsList"
                                     Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                     Background="Transparent"
                                     BorderThickness="{DynamicResource NetLoom.Thickness.None}"
                                     ItemContainerStyle="{StaticResource NetLoom.Style.PlainListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionMode="Single"
                                     SelectionChanged="OnShellProfileSettingsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NetLoom.Style.OperatorCard}"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <Border Visibility="{Binding ActiveVisibility}"
                                                            Background="{DynamicResource NetLoom.Brush.AccentSoft}"
                                                            CornerRadius="{DynamicResource NetLoom.Radius.Pill}"
                                                            Padding="{DynamicResource NetLoom.Thickness.PillPadding}"
                                                            Margin="{DynamicResource NetLoom.Thickness.FieldGapLeft}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActiveText}"
                                                                   Foreground="{DynamicResource NetLoom.Brush.AccentText}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{DynamicResource NetLoom.FontSize.Caption}" />
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Content="{Binding EditAction}"
                                                        Click="OnShellProfileRowEditClick" />
                                                <Button Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                        Content="{Binding DeleteAction}"
                                                        Foreground="{DynamicResource NetLoom.Brush.Critical}"
                                                        BorderBrush="{DynamicResource NetLoom.Brush.Critical}"
                                                        Click="OnShellProfileRowDeleteClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Visibility="Collapsed">
                                <Button x:Name="ShellProfileEditButton"
                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                        Click="OnShellProfileEditClick" />
                                <Button x:Name="ShellProfileDeleteButton"
                                        Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                        Click="OnShellProfileDeleteClick" />
                            </Grid>

                            <TextBlock x:Name="SettingsPollingTitleText"
                                       Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}" />

                            <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource NetLoom.Grid.FieldGap}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SettingsMonitoringIntervalLabelText"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                    <TextBox x:Name="SettingsMonitoringIntervalTextBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SettingsMonitoringIntervalLabelText}"
                                             Text="{Binding Text, ElementName=MonitoringIntervalTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SettingsMonitoringTimeoutLabelText"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                    <TextBox x:Name="SettingsMonitoringTimeoutTextBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SettingsMonitoringTimeoutLabelText}"
                                             Text="{Binding Text, ElementName=MonitoringTimeoutTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="SettingsMonitoringRetriesLabelText"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                    <TextBox x:Name="SettingsMonitoringRetriesTextBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SettingsMonitoringRetriesLabelText}"
                                             Text="{Binding Text, ElementName=MonitoringRetriesTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock x:Name="SettingsMonitoringMaxRepetitionsLabelText"
                                               Style="{StaticResource NetLoom.Style.FieldLabel}" />
                                    <TextBox x:Name="SettingsMonitoringMaxRepetitionsTextBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SettingsMonitoringMaxRepetitionsLabelText}"
                                             Text="{Binding Text, ElementName=MonitoringMaxRepetitionsTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="SettingsMonitoringKindsLabelText"
                                       Style="{StaticResource NetLoom.Style.FieldLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.FieldGapTop}" />
                            <WrapPanel Margin="{DynamicResource NetLoom.Thickness.GapXsTop}">
                                <CheckBox x:Name="SettingsMonitoringKindLldpCheckBox"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindLldpCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindCdpCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindCdpCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindFdbCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindFdbCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindArpCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindArpCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindHealthCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindHealthCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindInterfaceCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindInterfaceCheckBox, Mode=TwoWay}" />
                                <CheckBox x:Name="SettingsMonitoringKindStpCheckBox"
                                          Margin="{DynamicResource NetLoom.Thickness.InlineGap}"
                                          IsChecked="{Binding IsChecked, ElementName=MonitoringKindStpCheckBox, Mode=TwoWay}" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="{DynamicResource NetLoom.Thickness.ButtonRowGap}">
                                <Button x:Name="SettingsMonitoringSaveButton"
                                        Click="OnSettingsMonitoringSaveClick" />
                                <TextBlock x:Name="SettingsMonitoringStatusText"
                                           Style="{StaticResource NetLoom.Style.MutedText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock x:Name="ShellSettingsMapTitleText"
                                       Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                       Margin="{DynamicResource NetLoom.Thickness.SectionGapTop}" />

                            <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsAnimationLabelText"
                                           Style="{StaticResource NetLoom.Style.FieldLabel}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource NetLoom.Style.SegmentedGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SettingsMotionNormalButton"
                                                Style="{StaticResource NetLoom.Style.SegmentButton}"
                                                Click="OnSettingsMotionNormalClick" />
                                        <Button x:Name="SettingsMotionReducedButton"
                                                Style="{StaticResource NetLoom.Style.SegmentButton}"
                                                Click="OnSettingsMotionReducedClick" />
                                        <Button x:Name="SettingsMotionOffButton"
                                                Style="{StaticResource NetLoom.Style.SegmentButton}"
                                                Click="OnSettingsMotionOffClick" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsThemeLabelText"
                                           Style="{StaticResource NetLoom.Style.FieldLabel}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource NetLoom.Style.SegmentedGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SettingsThemeLightButton"
                                                Style="{StaticResource NetLoom.Style.SegmentButton}"
                                                Click="OnSettingsThemeLightClick" />
                                        <Button x:Name="SettingsThemeDarkButton"
                                                Style="{StaticResource NetLoom.Style.SegmentButton}"
                                                Click="OnSettingsThemeDarkClick" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Button x:Name="MapSettingsButton"
                                    Visibility="Collapsed"
                                    Click="OnMapSettingsClick" />
                            <Button x:Name="ShellSettingsThemeButton"
                                    Visibility="Collapsed"
                                    Click="OnShellThemeClick" />
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <Grid x:Name="ShellMapSurface"
                  Grid.Column="2"
                  Background="{DynamicResource NetLoom.Brush.Canvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="Adr083MapToolbar"
                        Grid.Row="0"
                        Padding="12,10"
                        Background="{DynamicResource NetLoom.Brush.Surface}"
                        BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                        BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A3 (sprint46-mockup-gap): в «Предупреждениях» над картой только «Показать: всё ⌄»,
                             полная панель карты остаётся скрытой (ADR-083 п. 3). -->
                        <Button x:Name="Adr083AlertsMapFocusButton"
                                Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                ContentTemplate="{Binding ContentTemplate, ElementName=MapOperationalFocusButton}"
                                Click="OnAdr083MapOperationalFocusClick" />
                        <WrapPanel x:Name="Adr083MapPrimaryToolbar"
                                   VerticalAlignment="Center">
                            <Border Style="{StaticResource NetLoom.Style.SegmentedGroup}"
                                    Margin="{DynamicResource NetLoom.Thickness.ToolbarGroupGap}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MapViewModeButton"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnMapViewModeClick" />
                                    <Button x:Name="MapEditModeButton"
                                            Style="{StaticResource NetLoom.Style.SegmentButton}"
                                            Click="OnMapEditModeClick" />
                                </StackPanel>
                            </Border>
                            <!-- M1: «Показать: всё ⌄» — выпадающий выбор, как в макете netloom-v2-1. -->
                            <Button x:Name="MapOperationalFocusButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="{DynamicResource NetLoom.Thickness.ToolbarGroupGap}"
                                    Click="OnAdr083MapOperationalFocusClick">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}"
                                                       VerticalAlignment="Center" />
                                            <Path Width="{DynamicResource NetLoom.Expander.ArrowSize}"
                                                  Height="{DynamicResource NetLoom.Expander.ArrowSize}"
                                                  Margin="{DynamicResource NetLoom.Thickness.DropDownArrowMargin}"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M 0,0 L 4,4 L 8,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Name="MapExportButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="OnSiteExportClick" />
                            <Button x:Name="MapRefreshDataButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="OnMonitoringRefreshTopologyClick" />
                            <Button x:Name="ManualTopologyButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="OnManualTopologyClick" />
                            <Button x:Name="LocationsButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="OnLocationsClick" />
                            <Border x:Name="Adr083MapEditModeIndicator"
                                    Padding="10,5"
                                    Background="{DynamicResource NetLoom.Brush.WarningSoft}"
                                    BorderBrush="{DynamicResource NetLoom.Brush.Warning}"
                                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderThin}"
                                    CornerRadius="{DynamicResource NetLoom.Radius.Panel}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="Adr083MapEditModeIndicatorText"
                                           Foreground="{DynamicResource NetLoom.Brush.Warning}" />
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="MapLockSelectedCheckBox"
                                      Visibility="Collapsed"
                                      IsEnabled="False"
                                      Checked="OnMapLockSelectedChanged"
                                      Unchecked="OnMapLockSelectedChanged" />
                            <TextBlock x:Name="MapZoomLabelText"
                                       Visibility="Collapsed" />
                            <Button x:Name="MapZoomOutButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnMapZoomOutClick" />
                            <TextBlock x:Name="MapZoomValueText"
                                       Margin="10,0,2,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource NetLoom.FontFamily.Mono}" />
                            <Button x:Name="MapZoomInButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnMapZoomInClick" />
                            <!-- M1: «Показать всё» — значок рамки, как в макете; текст остаётся содержимым кнопки
                                 (имя для UI Automation) и подсказкой. -->
                            <Button x:Name="MapFitAllButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Click="OnMapFitAllClick">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Path Width="{DynamicResource NetLoom.Map.ToolbarIconSize}"
                                              Height="{DynamicResource NetLoom.Map.ToolbarIconSize}"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="{StaticResource NetLoom.Icon.MapFitAll}" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="MapTitleText" />
                            <TextBlock x:Name="MapStatusText" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1">
                    <Border x:Name="Adr083MapMonitoringNotice"
                            Padding="{DynamicResource NetLoom.Thickness.MapNoticePadding}"
                            Background="{DynamicResource NetLoom.Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="Adr083MapMonitoringNoticeText"
                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="MapQualityNotice"
                            Padding="{DynamicResource NetLoom.Thickness.MapNoticePadding}"
                            Background="{DynamicResource NetLoom.Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource NetLoom.Brush.Border}"
                            BorderThickness="{DynamicResource NetLoom.Thickness.BorderBottom}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MapQualityGlyph"
                                           Margin="{DynamicResource NetLoom.Thickness.StatusGlyph}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <ToggleButton x:Name="MapQualityToggle"
                                              Style="{StaticResource NetLoom.Style.LinkToggleButton}"
                                              IsChecked="False">
                                    <TextBlock x:Name="MapQualitySummaryText"
                                               shell:LiveRegion.IsPolite="True"
                                               Typography.NumeralAlignment="Tabular" />
                                </ToggleButton>
                        </StackPanel>
                            <ScrollViewer x:Name="MapQualityDetails"
                                          MaxHeight="{DynamicResource NetLoom.Map.QualityListMaxHeight}"
                                          Background="{DynamicResource NetLoom.Brush.SurfaceMuted}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource NetLoom.Style.MapScrollBar}">
                                        <Setter Property="Background" Value="{DynamicResource NetLoom.Brush.SurfaceMuted}" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}"
                                           BasedOn="{StaticResource NetLoom.Style.MapScrollViewer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=MapQualityToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl x:Name="MapQualityGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{DynamicResource NetLoom.Thickness.GroupGap}">
                                            <TextBlock Text="{Binding Heading}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       shell:AutomationHeading.Level="2"
                                                       Margin="{DynamicResource NetLoom.Thickness.FieldLabelCompact}" />
                                            <ItemsControl ItemsSource="{Binding Gaps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="{DynamicResource NetLoom.Thickness.ListRow}">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="{Binding ShowText}"
                                                                    Tag="{Binding Gap}"
                                                                    Style="{StaticResource NetLoom.Style.LinkButton}"
                                                                    Margin="{DynamicResource NetLoom.Thickness.FieldGapLeft}"
                                                                    AutomationProperties.Name="{Binding ShowName}"
                                                                    Click="OnMapQualityShowClick" />
                                                            <TextBlock Text="{Binding Text}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                </StackPanel>

                <ScrollViewer x:Name="MapScrollViewer"
                              Grid.Row="2"
                              Style="{StaticResource NetLoom.Style.MapScrollViewer}"
                              Background="{DynamicResource NetLoom.Brush.Canvas}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnMapPreviewMouseWheel"
                              PreviewMouseDown="OnMapPreviewMouseDown"
                              PreviewMouseMove="OnMapPreviewMouseMove"
                              PreviewMouseUp="OnMapPreviewMouseUp">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource NetLoom.Style.MapScrollBar}" />
                    </ScrollViewer.Resources>
                    <Canvas x:Name="MapCanvas"
                            Background="{DynamicResource NetLoom.Brush.Canvas}"
                            MouseLeftButtonDown="OnMapCanvasMouseLeftButtonDown"
                            Width="{DynamicResource NetLoom.Map.CanvasWidth}"
                            Height="{DynamicResource NetLoom.Map.CanvasHeight}" />
                </ScrollViewer>
            </Grid>

            <ContentControl x:Name="ShellWorkspaceEditorHost"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Panel.ZIndex="30"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="{DynamicResource NetLoom.Brush.Window}" />
            <Button x:Name="ShellInspectorRevealButton"
                    Grid.Column="2"
                    Width="32"
                    Height="28"
                    Margin="0,12,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="{DynamicResource NetLoom.Thickness.None}"
                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                    Visibility="Collapsed"
                    Panel.ZIndex="40"
                    Click="OnShellInspectorRevealClick">‹</Button>
            <GridSplitter x:Name="ShellInspectorSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndCurrent"
                          Background="Transparent"
                          Panel.ZIndex="25"
                          DragCompleted="OnShellInspectorSplitterDragCompleted" />
            <Border x:Name="ShellInspectorPanel"
                    Grid.Column="3"
                    MinWidth="320"
                    MaxWidth="520"
                    Panel.ZIndex="20"
                    Style="{StaticResource NetLoom.Style.Panel}"
                    Padding="{DynamicResource NetLoom.Thickness.PanelPadding}"
                    BorderThickness="{DynamicResource NetLoom.Thickness.BorderLeft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Button x:Name="ShellInspectorCollapseButton"
                                Width="32"
                                Height="28"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,6"
                                Padding="{DynamicResource NetLoom.Thickness.None}"
                                Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                Click="OnShellInspectorCollapseClick">›</Button>
                        <TextBlock x:Name="DiagnosticTitleText"
                                   Style="{StaticResource NetLoom.Style.SectionTitle}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="InspectorEntityTypeText"
                                   Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapSmTop}" />
                        <TextBlock x:Name="DiagnosticElementTitleText"
                                   Style="{StaticResource NetLoom.Style.SectionTitle}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="InspectorOperationalStatusText"
                                   Style="{StaticResource NetLoom.Style.StatusEmphasis}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="InspectorProblemText"
                                   Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="InspectorProblemExplanationText"
                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <!-- E5 (sprint46-mockup-gap): главное действие и «Опросить» в одной строке, как в макете netloom-v2-2. -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                            <Button x:Name="InspectorPrimaryActionButton"
                                    HorizontalAlignment="Left"
                                    Margin="{DynamicResource NetLoom.Thickness.ToolbarGroupGap}"
                                    Visibility="Collapsed"
                                    Click="OnInspectorPrimaryActionClick" />
                            <Button x:Name="InspectorPollButton"
                                    Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="OnMonitoringPollNowClick" />
                        </StackPanel>
                        <TextBlock x:Name="DiagnosticElementSubtitleText"
                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DiagnosticStatusText"
                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                   Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <TabControl x:Name="InspectorTabControl"
                                Grid.Row="1"
                                Margin="{DynamicResource NetLoom.Thickness.GapSmTop}"
                                Style="{StaticResource NetLoom.Style.InspectorTabs}">
                        <TabItem x:Name="InspectorOverviewTab"
                                 Style="{StaticResource NetLoom.Style.InspectorTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="DiagnosticPrimaryTitleText"
                                               Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                               Margin="{DynamicResource NetLoom.Thickness.SubsectionLabel}" />
                                    <ItemsControl x:Name="DiagnosticFieldsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="{DynamicResource NetLoom.Thickness.ListRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="InspectorFieldLabelText"
                                                               Text="{Binding Label}"
                                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                                               Margin="0,0,12,0" />
                                                    <TextBlock x:Name="InspectorFieldValueText"
                                                               Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="InspectorFieldSectionText"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Visibility="Collapsed" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsProse}"
                                                                 Value="True">
                                                        <Setter TargetName="InspectorFieldValueText"
                                                                Property="HorizontalAlignment"
                                                                Value="Left" />
                                                        <Setter TargetName="InspectorFieldValueText"
                                                                Property="TextAlignment"
                                                                Value="Left" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSectionHeader}"
                                                                 Value="True">
                                                        <Setter TargetName="InspectorFieldLabelText"
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Setter TargetName="InspectorFieldValueText"
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Setter TargetName="InspectorFieldSectionText"
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="DiagnosticSecondaryTitleText"
                                               Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                               Margin="{DynamicResource NetLoom.Thickness.SubsectionLabel}" />
                                    <ItemsControl x:Name="DiagnosticSecondaryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="{DynamicResource NetLoom.Thickness.ListRow}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="InspectorInterfacesTab"
                                 Style="{StaticResource NetLoom.Style.InspectorTab}">
                            <ScrollViewer x:Name="InspectorInterfacesScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="DiagnosticInterfaceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                    Margin="{DynamicResource NetLoom.Thickness.ListRow}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Tag="{Binding EntityId}"
                                                    ToolTip="{Binding PortMeta}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Click="OnDiagnosticInterfaceClick">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PortStatusGlyph}"
                                                                   Margin="0,0,6,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPortDegraded}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource NetLoom.Brush.Warning}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPortDown}" Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding PortName}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PortSummary}"
                                                               Margin="8,0,0,0"
                                                               TextAlignment="Right"
                                                               TextWrapping="NoWrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource NetLoom.Brush.TextPrimary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRiskyStp}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource NetLoom.Brush.Critical}" />
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding PortNeighborLine}"
                                                               Style="{StaticResource NetLoom.Style.MutedText}"
                                                               Margin="{DynamicResource NetLoom.Thickness.GapXsTop}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="InspectorLinksTab"
                                 Style="{StaticResource NetLoom.Style.InspectorTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DiagnosticLinkList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NetLoom.Style.SecondaryButton}"
                                                    Margin="{DynamicResource NetLoom.Thickness.ListRow}"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{Binding EntityId}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Click="OnDiagnosticLinkClick">
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="InspectorEvidenceTab"
                                 Style="{StaticResource NetLoom.Style.InspectorTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="DiagnosticTertiaryTitleText"
                                               Style="{StaticResource NetLoom.Style.SidebarSectionLabel}"
                                               Margin="{DynamicResource NetLoom.Thickness.SubsectionLabel}" />
                                    <ItemsControl x:Name="DiagnosticTertiaryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="{DynamicResource NetLoom.Thickness.ListRow}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Expander x:Name="InspectorTechnicalDetailsExpander"
                              Grid.Row="2"
                              IsExpanded="False"
                              Margin="{DynamicResource NetLoom.Thickness.GapSmTop}">
                        <TextBlock x:Name="InspectorEntityIdText"
                                   Style="{StaticResource NetLoom.Style.MonoText}"
                                   Margin="{DynamicResource NetLoom.Thickness.ExpanderContent}"
                                   TextWrapping="Wrap" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource NetLoom.Style.Panel}"
                Padding="{DynamicResource NetLoom.Thickness.ShellEventPadding}"
                BorderThickness="{DynamicResource NetLoom.Thickness.BorderTop}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ShellEventTitleText"
                           Style="{StaticResource NetLoom.Style.MutedText}"
                           VerticalAlignment="Center" />

                <Grid Grid.Column="1"
                      Margin="{DynamicResource NetLoom.Thickness.InlineGap}">
                    <TextBlock x:Name="ShellEventEmptyText"
                               Style="{StaticResource NetLoom.Style.MutedText}"
                               VerticalAlignment="Center" />
                    <ItemsControl x:Name="ShellEventList" Focusable="False" shell:LiveRegion.IsPolite="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Sprint 47: видны только события, которые помещаются целиком; менее важные отпадают. -->
                                <shell:FitStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- G4: строка события по макетам ADR-083 — круглый значок важности, время моноширинным,
                                     заголовок жирным, участники приглушённо; без рамки, пока нет наведения или фокуса. -->
                                <Button Style="{StaticResource NetLoom.Style.FlatButton}"
                                        Margin="{DynamicResource NetLoom.Thickness.EventItemGap}"
                                        DataContext="{Binding}"
                                        AutomationProperties.Name="{Binding Title}"
                                        ToolTip="{Binding Scope}"
                                        Click="OnShellEventClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="EventBadge"
                                                Style="{StaticResource NetLoom.Style.EventBadge}"
                                                Margin="{DynamicResource NetLoom.Thickness.EventPartGap}">
                                            <TextBlock x:Name="EventGlyph"
                                                       Text="•"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource NetLoom.FontSize.Caption}"
                                                       Foreground="{DynamicResource NetLoom.Brush.OnAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding TimeText}"
                                                   Style="{StaticResource NetLoom.Style.MonoText}"
                                                   VerticalAlignment="Center"
                                                   Margin="{DynamicResource NetLoom.Thickness.EventPartGap}" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="EventScopeText"
                                                   Text="{Binding Scope, StringFormat=' · {0}'}"
                                                   Style="{StaticResource NetLoom.Style.MutedText}"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="{DynamicResource NetLoom.Event.ScopeMaxWidth}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Scope}" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Scope}"
                                                 Value="{x:Null}">
                                        <Setter TargetName="EventScopeText"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Scope}"
                                                 Value="">
                                        <Setter TargetName="EventScopeText"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCritical}"
                                                 Value="True">
                                        <Setter TargetName="EventBadge"
                                                Property="Background"
                                                Value="{DynamicResource NetLoom.Brush.Critical}" />
                                        <Setter TargetName="EventGlyph"
                                                Property="Text"
                                                Value="×" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}"
                                                 Value="True">
                                        <Setter TargetName="EventBadge"
                                                Property="Background"
                                                Value="{DynamicResource NetLoom.Brush.Warning}" />
                                        <Setter TargetName="EventGlyph"
                                                Property="Text"
                                                Value="!" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsResolved}"
                                                 Value="True">
                                        <!-- Норма нейтральна (ADR-083 п. 6): закрытое событие без цвета отклонения. -->
                                        <Setter TargetName="EventBadge"
                                                Property="Background"
                                                Value="{DynamicResource NetLoom.Brush.TextSecondary}" />
                                        <Setter TargetName="EventGlyph"
                                                Property="Text"
                                                Value="✓" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock x:Name="AlertTransitionText"
                           Grid.Column="1"
                           Visibility="Collapsed" />

                <Button x:Name="ShellAllEventsButton"
                        Grid.Column="2"
                        Style="{StaticResource NetLoom.Style.LinkButton}"
                        Click="OnShellAllEventsClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
